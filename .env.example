# Pfad zum ORIGINAL Instruct (BF16 auf Disk) — Download ist richtig
OMNI_MODEL_ID=/workspace/models/Qwen3-Omni-30B-A3B-Instruct

# 4-bit wie Gist (bitsandbytes beim Laden)
OMNI_LOAD_IN_4BIT=1
OMNI_ENABLE_AUDIO_OUTPUT=0
OMNI_FLASH_ATTN=0

# Weniger VRAM beim Laden (empfohlen auf 5090):
# pip install -U flash-attn --no-build-isolation
# OMNI_FLASH_ATTN=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
OMNI_CHUNK_SEC=30
OMNI_OVERLAP_SEC=2
OMNI_MAX_NEW_TOKENS=auto
OMNI_CLEAR_GPU_ON_START=1
