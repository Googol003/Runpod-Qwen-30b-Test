# RTX 5090 32 GB — 30B nur so:
OMNI_MODEL_ID=/workspace/models/Qwen3-Omni-30B-A3B-Instruct
OMNI_LOAD_IN_4BIT=1
OMNI_DEVICE_MAP=cuda
OMNI_ENABLE_AUDIO_OUTPUT=0
OMNI_FLASH_ATTN=0

OMNI_CHUNK_SEC=30
OMNI_OVERLAP_SEC=2
OMNI_MAX_NEW_TOKENS=auto
OMNI_PROGRESS=1
OMNI_CLEAR_GPU_ON_START=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
