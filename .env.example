# Hugging Face Qwen-Omni (transcribe_omni.py — kein Ollama für Audio)

# Modell (lokal oder HF-Id)
OMNI_MODEL_ID=/workspace/models/Qwen3-Omni-30B-A3B-Instruct
# Alternativ kleiner/schneller:
# OMNI_MODEL_ID=/workspace/models/Qwen2.5-Omni-7B

# 32 GB GPU + 30B: 4-bit Pflicht, sonst CPU-Offload
OMNI_LOAD_IN_4BIT=1
OMNI_NO_CPU_OFFLOAD=1
OMNI_FLASH_ATTN=0
# pip install bitsandbytes

# Chunking
OMNI_CHUNK_SEC=30
OMNI_OVERLAP_SEC=2
OMNI_MAX_NEW_TOKENS=auto
OMNI_PROGRESS=1
OMNI_HEARTBEAT_SEC=30

# Optional
# HF_TOKEN=...
# OMNI_DEVICE_MAP=cuda:0
