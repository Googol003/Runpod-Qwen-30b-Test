# Hugging Face Modell (30B MoE auf RunPod mit großer GPU)
OMNI_MODEL_ID=Qwen/Qwen3-Omni-30B-A3B-Instruct

# Alternativ kleiner zum Testen:
# OMNI_MODEL_ID=Qwen/Qwen2.5-Omni-7B

# Chunking (für Timecodes: Offset des Clips + geschätzte Zeiten im Clip)
OMNI_CHUNK_SEC=30
OMNI_OVERLAP_SEC=2
OMNI_MAX_NEW_TOKENS=auto
OMNI_FLASH_ATTN=1

# RTX 5090 / 32 GB + 30B-A3B: alles auf GPU (kein CPU-Offload)
# OMNI_LOAD_IN_4BIT=1
# OMNI_NO_CPU_OFFLOAD=1
# OMNI_DEVICE_MAP=cuda:0
# OMNI_FLASH_ATTN=0

# Hugging Face Token falls gated model:
# HF_TOKEN=hf_...
