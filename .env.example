# RTX 5090 32 GB — 4-bit 30B ≈ 15 GB
OMNI_MODEL_ID=/workspace/models/Qwen3-Omni-30B-A3B-Instruct
OMNI_LOAD_IN_4BIT=1
OMNI_LOAD_STRATEGY=cuda
OMNI_ENABLE_AUDIO_OUTPUT=0
OMNI_FLASH_ATTN=0

OMNI_CHUNK_SEC=30
OMNI_OVERLAP_SEC=2
OMNI_MAX_NEW_TOKENS=auto
OMNI_CLEAR_GPU_ON_START=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Nur Fallback wenn cuda OOM: OMNI_LOAD_STRATEGY=staged
OMNI_GPU_CAP_GB=28
OMNI_CPU_MEMORY=128GiB
