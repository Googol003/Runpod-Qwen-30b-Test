# Standard: Whisper (30s-Chunks) + Ollama — wie runpod_excel_corrector
TRANSCRIBE_BACKEND=ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:26b
LLM_TIMEOUT_S=300
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=auto
LLM_TEMPERATURE=0.05
OLLAMA_NUM_GPU=-1

# Whisper ASR (pro Chunk, GPU)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=de

# Chunking
OMNI_CHUNK_SEC=30
OMNI_OVERLAP_SEC=2
OMNI_MAX_NEW_TOKENS=auto
OMNI_PROGRESS=1

# Optional: altes HF Qwen-Omni (schwer, langsam auf 32GB)
# TRANSCRIBE_BACKEND=hf
# OMNI_MODEL_ID=Qwen/Qwen2.5-Omni-7B
# OMNI_FLASH_ATTN=0
