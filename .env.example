# RunPod RTX 5090 (32 GB) — Qwen3-Omni 30B mit 4-bit auf GPU
# cp .env.example .env  (oder .env liegt bereits im Repo)

OMNI_MODEL_ID=/workspace/models/Qwen3-Omni-30B-A3B-Instruct
# Alternativ kleiner/schneller (ohne 4-bit nötig):
# OMNI_MODEL_ID=/workspace/models/Qwen2.5-Omni-7B

# Quantisierung & GPU (30B auf 32 GB)
OMNI_LOAD_IN_4BIT=1
OMNI_LOAD_IN_8BIT=0
OMNI_NO_CPU_OFFLOAD=1
OMNI_FLASH_ATTN=0
OMNI_DEVICE_MAP=cuda:0
OMNI_GPU_RESERVE_GB=3

# Audio-Chunks
OMNI_CHUNK_SEC=30
OMNI_OVERLAP_SEC=2
OMNI_MAX_NEW_TOKENS=auto

# Laufzeit / UI
OMNI_PROGRESS=1
OMNI_HEARTBEAT_SEC=30
OMNI_EMPTY_CUDA=0

# Hugging Face (optional)
# HF_TOKEN=
