# RunPod RTX 5090 (32 GB) — Qwen3-Omni 30B mit 4-bit
# cp .env.example .env

OMNI_MODEL_ID=/workspace/models/Qwen3-Omni-30B-A3B-Instruct
# Alternativ (passt sicher auf 32 GB):
# OMNI_MODEL_ID=/workspace/models/Qwen2.5-Omni-7B

OMNI_LOAD_IN_4BIT=1
OMNI_LOAD_IN_8BIT=0
# Talker nicht laden — nur Transkript, spart viel VRAM
OMNI_ENABLE_AUDIO_OUTPUT=0
# 0 = bei Bedarf CPU-Offload (lädt eher); 1 = nur GPU (strenger)
OMNI_NO_CPU_OFFLOAD=0
OMNI_FLASH_ATTN=0
OMNI_DEVICE_MAP=auto
OMNI_GPU_RESERVE_GB=4

OMNI_CHUNK_SEC=30
OMNI_OVERLAP_SEC=2
OMNI_MAX_NEW_TOKENS=auto

OMNI_PROGRESS=1
OMNI_HEARTBEAT_SEC=30
OMNI_EMPTY_CUDA=1
OMNI_CLEAR_GPU_ON_START=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
OMNI_CPU_MEMORY=128GiB

# HF_TOKEN=
